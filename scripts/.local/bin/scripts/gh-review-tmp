#!/usr/bin/env bash
set -euo pipefail

PR="${1:-}"

# 1. Resolve upstream repository URL
REPO_URL=$(gh repo view --json url -q .url 2>/dev/null || git remote get-url origin 2>/dev/null || true)

if [ -z "$REPO_URL" ]; then
  echo "Error: Could not determine GitHub repository URL." >&2
  exit 1
fi

# 2. Interactive selection (binds /dev/tty for fzf stability)
if [ -z "$PR" ]; then
  if ! command -v fzf &> /dev/null; then
    echo "Error: Pass a PR number or install fzf." >&2
    exit 1
  fi
  PR_LINE=$(gh pr list --limit 30 | fzf --prompt="Select PR to review > " < /dev/tty)
  PR=$(echo "$PR_LINE" | awk '{print $1}' | tr -d '#')
fi

[ -z "$PR" ] && exit 0

WORK_DIR="/tmp/pr-${PR}"
BRANCH_NAME="review/pr-${PR}"

# 3. Create isolated standalone directory
rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR"

echo "Creating isolated throwaway repo in ${WORK_DIR}..." >&2

git init "$WORK_DIR" --quiet

(
  cd "$WORK_DIR"
  git remote add origin "$REPO_URL"

  # Lock remote from accidental git push commands
  git config remote.origin.pushurl "DISABLED_READ_ONLY_REVIEW"

  # Fetch PR and switch branch
  git fetch origin "pull/${PR}/head:${BRANCH_NAME}" --quiet
  git checkout "$BRANCH_NAME" --quiet
)

# 4. Output path for shell wrapper navigation
echo "$WORK_DIR"

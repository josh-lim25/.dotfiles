{
  // devcontainer shell setup
  "dotfiles.repository": "https://github.com/josh-lim25/.dotfiles.git",
  "dotfiles.targetPath": "~/.dotfiles",
  "dotfiles.installCommand": "install-devcontainer.sh",

  // make it like nvim
  "terminal.integrated.defaultProfile.linux": "zsh",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "editor.semanticHighlighting.enabled": true,
  "vscode-neovim.neovimExecutablePaths.linux": "/snap/bin/nvim",
  "vscode-neovim.neovimInitVimPaths.linux": "/home/josh/.config/nvim-vscode/init.lua",
  "keyboard.dispatch": "keyCode",
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 999,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.experimental.asyncTokenization": true,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "extensions.autoUpdate": "off",
  "editor.formatOnSave": true,
  "editor.inlayHints.enabled": "on",

  // Go
  // "[go]": {
  //   "editor.defaultFormatter": "golang.go",
  //   "editor.formatOnSave": true,
  //   "editor.codeActionsOnSave": {
  //     "source.organizeImports": "explicit"
  //   }
  // },
  // "go.useLanguageServer": true,
  // // Use the gopls/tools installed on system; don't let the extension manage them.
  // "go.toolsManagement.checkForUpdates": "off",
  // // From `go env`:
  // "go.goroot": "/home/josh/go",
  // "go.gopath": "/home/josh/go-workspace",
  // "gopls": {
  //   "ui.semanticTokens": true,
  //   "formatting.gofumpt": false
  // },

  // aesthetics
  "workbench.colorTheme": "Kanagawa Paper Ink (custom)",
  "chat.viewSessions.orientation": "stacked",
  // "workbench.colorCustomizations": {
  // "[Kanagawa Paper Ink]": {
  //   "editor.findMatchBackground": "#43436c",
  //   "editor.findMatchHighlightBackground": "#43436c66"
  // }
  // },

  // efficiency
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/build/**": true,
  },
  "search.exclude": {
    "**/build": true,
  },
  // Offloads terminal rendering to your GPU to free up CPU resources.
  "terminal.integrated.gpuAcceleration": "auto",
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
}
